<style is:global>
  *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }
  html { scroll-behavior: smooth; font-size: 16px; }
  body {
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
    background: #07071a;
    color: #f1f5f9;
    line-height: 1.6;
    overflow-x: hidden;
  }

  :root {
    --bg: #07071a;
    --bg2: #0e0e28;
    --card: rgba(255,255,255,0.04);
    --card-hover: rgba(255,255,255,0.07);
    --border: rgba(255,255,255,0.08);
    --text: #f1f5f9;
    --muted: #94a3b8;
    --v: #7c3aed;
    --o: #f97316;
    --g: #fbbf24;
    --grad: linear-gradient(135deg, #7c3aed 0%, #f97316 100%);
    --grad-rev: linear-gradient(135deg, #f97316 0%, #7c3aed 100%);
    --radius: 16px;
    --nav-h: 72px;
  }

  .container { max-width: 1200px; margin: 0 auto; padding: 0 2rem; }
  .gradient-text {
    background: var(--grad);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  /* ======= HEADER ======= */
  header {
    position: fixed;
    top: 0; width: 100%;
    background: rgba(7, 7, 26, 0.92);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-bottom: 1px solid var(--border);
    z-index: 1000;
    height: var(--nav-h);
    transition: all 0.3s;
  }
  .nav-container {
    max-width: 1200px; margin: 0 auto;
    padding: 0 2rem;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .logo { display: flex; align-items: center; gap: 0.75rem; text-decoration: none; }
  .logo-icon {
    width: 44px; height: 44px;
    background: var(--grad);
    border-radius: 10px;
    display: flex; align-items: center; justify-content: center;
    font-size: 1.1rem; font-weight: 900; color: white;
    letter-spacing: -1px;
    flex-shrink: 0;
  }
  .logo-text { display: flex; flex-direction: column; line-height: 1.1; }
  .logo-main {
    font-size: 1.1rem; font-weight: 800;
    background: var(--grad);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  .logo-sub { font-size: 0.65rem; font-weight: 600; color: var(--muted); letter-spacing: 3px; text-transform: uppercase; }
  .nav-links { display: flex; gap: 0.25rem; list-style: none; align-items: center; }
  .nav-links a {
    color: var(--muted); font-weight: 500; font-size: 0.9rem;
    text-decoration: none; padding: 0.5rem 0.75rem; border-radius: 8px;
    transition: all 0.2s;
  }
  .nav-links a:hover { color: var(--text); background: var(--card); }
  .nav-cta {
    background: var(--grad) !important;
    color: white !important;
    padding: 0.5rem 1.25rem !important;
    border-radius: 8px !important;
    font-weight: 600 !important;
    box-shadow: 0 4px 15px rgba(124,58,237,0.3);
  }
  .nav-cta:hover { transform: translateY(-1px); box-shadow: 0 6px 20px rgba(124,58,237,0.4) !important; background: var(--grad-rev) !important; }
  .hamburger {
    display: none; flex-direction: column; justify-content: space-between;
    width: 28px; height: 20px; cursor: pointer;
    background: none; border: none; padding: 0;
  }
  .hamburger span {
    display: block; width: 100%; height: 2px;
    background: var(--text); border-radius: 2px; transition: all 0.3s;
  }
  .hamburger.open span:nth-child(1) { transform: rotate(45deg) translate(5px, 6px); }
  .hamburger.open span:nth-child(2) { opacity: 0; }
  .hamburger.open span:nth-child(3) { transform: rotate(-45deg) translate(6px, -7px); }

  /* ======= MOBILE MENU ======= */
  .mobile-menu {
    position: fixed; top: 0; left: 0; width: 100%; height: 100vh;
    background: rgba(7,7,26,0.98); backdrop-filter: blur(20px);
    z-index: 1001;
    display: flex; flex-direction: column;
    align-items: center; justify-content: center; gap: 1.5rem;
    opacity: 0; visibility: hidden; transition: all 0.3s;
  }
  .mobile-menu.open { opacity: 1; visibility: visible; }
  .mobile-menu a {
    font-size: 1.4rem; font-weight: 600; color: var(--muted);
    text-decoration: none; transition: color 0.2s;
    padding: 0.5rem 2rem;
  }
  .mobile-menu a:hover, .mobile-menu a:focus { color: var(--text); }
  .mobile-cta {
    background: var(--grad) !important;
    color: white !important;
    padding: 0.9rem 2rem !important;
    border-radius: 10px !important;
    margin-top: 0.5rem;
  }
  .mobile-close {
    position: absolute; top: 1.5rem; right: 2rem;
    background: none; border: none; color: var(--muted);
    font-size: 1.8rem; cursor: pointer; width: 44px; height: 44px;
    display: flex; align-items: center; justify-content: center;
    border-radius: 8px; transition: color 0.2s;
  }
  .mobile-close:hover { color: var(--text); }

  /* ======= HERO ======= */
  .hero {
    min-height: 100vh;
    display: flex; align-items: center;
    position: relative; overflow: hidden;
    padding-top: var(--nav-h);
  }
  .hero-bg {
    position: absolute; inset: 0;
    background: linear-gradient(-45deg, #07071a, #1a0742, #0d0d2e, #200b4a);
    background-size: 400% 400%;
    animation: gradFlow 18s ease infinite;
  }
  @keyframes gradFlow {
    0% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
    100% { background-position: 0% 50%; }
  }
  .hero-orb {
    position: absolute; border-radius: 50%;
    filter: blur(80px); pointer-events: none;
  }
  .hero-orb-1 {
    width: 500px; height: 500px;
    background: radial-gradient(circle, rgba(124,58,237,0.25) 0%, transparent 70%);
    top: -100px; right: -100px;
  }
  .hero-orb-2 {
    width: 400px; height: 400px;
    background: radial-gradient(circle, rgba(249,115,22,0.2) 0%, transparent 70%);
    bottom: -50px; left: 10%;
  }
  .hero-content {
    position: relative; z-index: 1;
    text-align: center;
    padding: 4rem 2rem;
    animation: fadeUp 0.8s ease;
  }
  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(30px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .hero-badge {
    display: inline-flex; align-items: center; gap: 0.5rem;
    background: rgba(255,255,255,0.06);
    border: 1px solid rgba(255,255,255,0.12);
    border-radius: 999px; padding: 0.4rem 1rem;
    font-size: 0.85rem; color: var(--muted); margin-bottom: 1.5rem;
  }
  .badge-dot {
    width: 8px; height: 8px; border-radius: 50%;
    background: var(--grad); animation: pulse 2s infinite;
  }
  @keyframes pulse {
    0%, 100% { box-shadow: 0 0 0 0 rgba(124,58,237,0.4); }
    50% { box-shadow: 0 0 0 6px rgba(124,58,237,0); }
  }
  .hero h1 {
    font-size: clamp(2.2rem, 5vw, 4rem); font-weight: 900;
    line-height: 1.15; margin-bottom: 1.5rem;
    color: var(--text);
  }
  .hero-sub {
    font-size: clamp(1rem, 1.5vw, 1.25rem); color: var(--muted);
    max-width: 700px; margin: 0 auto 2.5rem; line-height: 1.7;
  }
  .hero-btns {
    display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap;
    margin-bottom: 3rem;
  }
  .btn {
    display: inline-flex; align-items: center; gap: 0.5rem;
    padding: 0.9rem 2rem; border-radius: 10px;
    font-weight: 700; font-size: 1rem;
    text-decoration: none; cursor: pointer; border: none;
    transition: all 0.3s;
  }
  .btn-grad {
    background: var(--grad); color: white;
    box-shadow: 0 4px 20px rgba(124,58,237,0.35);
  }
  .btn-grad:hover { transform: translateY(-2px); box-shadow: 0 8px 30px rgba(124,58,237,0.5); }
  .btn-outline {
    background: transparent; color: var(--text);
    border: 1px solid var(--border);
  }
  .btn-outline:hover { background: var(--card); border-color: rgba(255,255,255,0.2); transform: translateY(-2px); }
  .hero-stats {
    display: flex; align-items: center; justify-content: center;
    gap: 2rem; flex-wrap: wrap;
  }
  .stat { text-align: center; }
  .stat-n { display: block; font-size: 2rem; font-weight: 900; line-height: 1; }
  .stat-l { font-size: 0.8rem; color: var(--muted); text-transform: uppercase; letter-spacing: 1px; }
  .stat-div { width: 1px; height: 40px; background: var(--border); }
  .hero-scroll {
    position: absolute; bottom: 2rem; left: 50%;
    transform: translateX(-50%);
    display: flex; justify-content: center;
  }
  .scroll-line {
    width: 1px; height: 50px;
    background: linear-gradient(to bottom, transparent, rgba(255,255,255,0.3));
    animation: scrollAnim 2s ease infinite;
  }
  @keyframes scrollAnim {
    0%, 100% { opacity: 0; transform: scaleY(0); transform-origin: top; }
    50% { opacity: 1; transform: scaleY(1); transform-origin: top; }
  }

  /* ======= CLIENTS BAR ======= */
  .clients-bar {
    background: var(--bg2);
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    padding: 2.5rem 2rem;
  }
  .clients-label {
    text-align: center; color: var(--muted);
    font-size: 0.8rem; text-transform: uppercase; letter-spacing: 3px;
    font-weight: 600; margin-bottom: 1.5rem;
  }
  .clients-logos {
    display: flex; justify-content: center;
    align-items: center; gap: 4rem; flex-wrap: wrap;
  }
  .client-logo-wrap {
    display: flex; align-items: center; justify-content: center;
    opacity: 0.7; transition: opacity 0.3s; filter: brightness(0) invert(1);
  }
  .client-logo-wrap:hover { opacity: 1; }
  .client-logo-wrap img { max-height: 50px; max-width: 160px; object-fit: contain; }
  .text-logo {
    font-size: 1.2rem; font-weight: 800; color: var(--text);
    letter-spacing: -0.5px;
  }

  /* ======= SECTIONS ======= */
  .section-dark { background: var(--bg); padding: 7rem 2rem; }
  .section-alt {
    background: var(--bg2);
    padding: 7rem 2rem;
  }
  .section-head {
    text-align: center;
    margin-bottom: 4.5rem;
    max-width: 680px;
    margin-left: auto;
    margin-right: auto;
  }
  .section-head h2 {
    font-size: clamp(1.9rem, 3vw, 3rem);
    font-weight: 800;
    margin-bottom: 1.25rem;
    line-height: 1.15;
    letter-spacing: -0.02em;
  }
  .section-head p {
    color: var(--muted);
    font-size: 1.1rem;
    line-height: 1.85;
    max-width: 560px;
    margin: 0 auto;
  }
  .section-tag {
    display: inline-block;
    background: rgba(124,58,237,0.12);
    border: 1px solid rgba(124,58,237,0.25);
    color: #a78bfa;
    border-radius: 999px;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    padding: 0.35rem 1.1rem;
    margin-bottom: 1.1rem;
  }

  /* ======= SERVICES GRID ======= */
  .cards-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
  }
  .card {
    background: rgba(255,255,255,0.025);
    border: 1px solid rgba(255,255,255,0.07);
    border-radius: 20px;
    padding: 2.25rem 2rem;
    transition: all 0.4s cubic-bezier(0.4,0,0.2,1);
    position: relative;
    overflow: hidden;
  }
  .card::after {
    content: '';
    position: absolute;
    top: 0; left: 10%; right: 10%;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(124,58,237,0.7), rgba(249,115,22,0.5), transparent);
    opacity: 0;
    transition: opacity 0.4s;
  }
  .card:hover::after { opacity: 1; }
  .card:hover {
    background: rgba(124,58,237,0.06);
    transform: translateY(-6px);
    border-color: rgba(124,58,237,0.2);
    box-shadow: 0 30px 60px rgba(0,0,0,0.35), 0 0 0 1px rgba(124,58,237,0.08);
  }
  .card-icon {
    width: 52px; height: 52px; border-radius: 14px;
    background: linear-gradient(135deg, rgba(124,58,237,0.2), rgba(249,115,22,0.1));
    display: flex; align-items: center; justify-content: center;
    margin-bottom: 1.5rem; color: #c4b5fd;
    border: 1px solid rgba(124,58,237,0.2);
  }
  .card-icon svg { width: 24px; height: 24px; }
  .card h3 {
    font-size: 1.05rem;
    font-weight: 700;
    margin-bottom: 0.875rem;
    color: var(--text);
    letter-spacing: -0.01em;
  }
  .card p {
    color: var(--muted);
    line-height: 1.85;
    font-size: 0.925rem;
  }

  /* ======= ABOUT ======= */
  .about-grid {
    display: grid; grid-template-columns: 380px 1fr;
    gap: 6rem; align-items: start;
    max-width: 1100px; margin: 0 auto;
  }
  .about-img-wrap { position: sticky; top: calc(var(--nav-h) + 2rem); }
  .about-img-frame {
    position: relative; border-radius: 24px; overflow: hidden;
    box-shadow: 0 40px 80px rgba(0,0,0,0.5), 0 0 0 1px rgba(255,255,255,0.06);
  }
  .about-img-frame::before {
    content: ''; position: absolute; inset: 0;
    background: linear-gradient(to bottom, transparent 55%, var(--bg2) 100%);
    z-index: 1;
  }
  .profile-photo { width: 100%; aspect-ratio: 3/4; object-fit: cover; object-position: center top; display: block; }
  .about-badge-card {
    margin-top: 1.25rem;
    background: rgba(124,58,237,0.08);
    border: 1px solid rgba(124,58,237,0.15);
    border-radius: 16px; padding: 1.25rem 1.5rem;
    display: flex; align-items: center; gap: 1.25rem;
  }
  .badge-num { font-size: 2.75rem; font-weight: 900; line-height: 1; }
  .badge-txt { color: var(--muted); font-size: 0.875rem; line-height: 1.4; }
  .about-text .section-tag { margin-bottom: 0.875rem; }
  .about-text h2 {
    font-size: clamp(1.7rem, 2.5vw, 2.4rem);
    font-weight: 800;
    margin-bottom: 1.75rem;
    line-height: 1.15;
    letter-spacing: -0.02em;
  }
  .about-text p {
    color: var(--muted);
    line-height: 1.9;
    margin-bottom: 1.375rem;
    font-size: 0.975rem;
  }
  .about-highlight {
    background: rgba(124,58,237,0.07);
    border: 1px solid rgba(124,58,237,0.15);
    border-radius: 16px; padding: 1.75rem 2rem;
    margin: 2rem 0; color: rgba(241,245,249,0.9);
    line-height: 1.9; font-size: 0.975rem;
  }

  /* ======= STEPS ======= */
  .steps-grid {
    display: grid; grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
  }
  .step-card {
    background: rgba(255,255,255,0.025);
    border: 1px solid rgba(255,255,255,0.06);
    border-radius: 20px; padding: 2.25rem 2rem;
    transition: all 0.4s cubic-bezier(0.4,0,0.2,1);
    position: relative; overflow: hidden;
  }
  .step-card::before {
    content: '';
    position: absolute; top: 0; left: 0; right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(249,115,22,0.6), transparent);
    opacity: 0; transition: opacity 0.4s;
  }
  .step-card:hover::before { opacity: 1; }
  .step-card:hover {
    background: rgba(249,115,22,0.04);
    transform: translateY(-6px);
    border-color: rgba(249,115,22,0.15);
    box-shadow: 0 30px 60px rgba(0,0,0,0.35);
  }
  .step-num {
    font-size: 3rem; font-weight: 900; line-height: 1;
    margin-bottom: 1rem; letter-spacing: -0.03em;
    opacity: 0.9;
  }
  .step-card h3 {
    font-size: 1rem; font-weight: 700;
    margin-bottom: 0.75rem; letter-spacing: -0.01em;
  }
  .step-card p { color: var(--muted); line-height: 1.85; font-size: 0.925rem; }

  /* ======= PORTFOLIO ======= */
  .portfolio-grid {
    display: grid; grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
  }
  .portfolio-card {
    background: rgba(255,255,255,0.025);
    border: 1px solid rgba(255,255,255,0.07);
    border-radius: 20px; padding: 2rem 2rem 1.75rem;
    transition: all 0.4s cubic-bezier(0.4,0,0.2,1);
    position: relative;
  }
  .portfolio-card:hover {
    background: rgba(124,58,237,0.055);
    transform: translateY(-6px);
    border-color: rgba(124,58,237,0.18);
    box-shadow: 0 30px 60px rgba(0,0,0,0.35), 0 0 0 1px rgba(124,58,237,0.06);
  }
  .portfolio-card-head {
    display: flex; align-items: center; gap: 1rem; margin-bottom: 1rem;
  }
  .portfolio-logo-wrap {
    width: 60px; height: 60px; border-radius: 12px;
    background: white; overflow: hidden; flex-shrink: 0;
    display: flex; align-items: center; justify-content: center;
  }
  .portfolio-logo { max-width: 100%; max-height: 100%; object-fit: contain; padding: 6px; }
  .portfolio-initials {
    background: var(--grad) !important;
    font-size: 1.1rem; font-weight: 900; color: white !important;
    letter-spacing: -0.5px;
  }
  .portfolio-initials::after { content: attr(data-initials); }
  .text-logo-card {
    font-size: 0.8rem; font-weight: 800; color: var(--v);
    text-align: center; padding: 4px;
  }
  .portfolio-tag {
    display: inline-block;
    font-size: 0.75rem; color: var(--muted); margin-bottom: 0.25rem;
  }
  .portfolio-card h3 { font-size: 1.1rem; font-weight: 700; }
  .portfolio-card > p { color: var(--muted); line-height: 1.7; font-size: 0.95rem; margin-bottom: 1rem; }
  .portfolio-status {
    display: inline-block; border-radius: 999px;
    font-size: 0.75rem; font-weight: 600; padding: 0.2rem 0.75rem;
    margin-bottom: 1rem;
  }
  .status-ongoing { background: rgba(251,191,36,0.15); color: var(--g); border: 1px solid rgba(251,191,36,0.3); }
  .status-completed { background: rgba(34,197,94,0.15); color: #4ade80; border: 1px solid rgba(34,197,94,0.3); }
  .portfolio-stats {
    display: flex; gap: 1.5rem; margin-bottom: 1.25rem; flex-wrap: wrap;
  }
  .p-stat { text-align: center; }
  .p-stat-n { display: block; font-size: 1.5rem; font-weight: 900; line-height: 1; }
  .p-stat span:last-child { font-size: 0.75rem; color: var(--muted); }
  .btn-expand {
    background: none; border: 1px solid var(--border); color: var(--muted);
    padding: 0.6rem 1.25rem; border-radius: 8px; cursor: pointer;
    font-size: 0.9rem; font-weight: 600; transition: all 0.2s;
  }
  .btn-expand:hover { border-color: var(--v); color: #a78bfa; background: rgba(124,58,237,0.08); }
  .portfolio-full { display: none; }
  .portfolio-full.open { display: block; animation: fadeIn 0.3s ease; }
  @keyframes fadeIn { from { opacity: 0; transform: translateY(-8px); } to { opacity: 1; transform: translateY(0); } }
  .portfolio-full p, .portfolio-full ul { color: var(--muted); line-height: 1.7; font-size: 0.95rem; margin-bottom: 1rem; }
  .portfolio-full ul { padding-left: 1.25rem; }
  .portfolio-full li { margin-bottom: 0.4rem; }
  .btn-collapse {
    background: none; border: 1px solid var(--border); color: var(--muted);
    padding: 0.5rem 1rem; border-radius: 8px; cursor: pointer;
    font-size: 0.85rem; transition: all 0.2s; margin-top: 0.5rem;
  }
  .btn-collapse:hover { border-color: rgba(255,255,255,0.3); color: var(--text); }

  /* ======= VIDEO SECTION ======= */
  .video-desc {
    color: var(--muted); max-width: 700px; margin: 0 auto 4.5rem;
    font-size: 1.075rem; line-height: 1.9; text-align: center;
  }
  .video-grid {
    display: grid; grid-template-columns: repeat(2, 1fr);
    gap: 1.25rem; max-width: 900px; margin: 0 auto;
  }
  .video-feature {
    background: rgba(255,255,255,0.025);
    border: 1px solid rgba(255,255,255,0.06);
    border-radius: 20px; padding: 2rem 1.75rem;
    display: flex; gap: 1.25rem; align-items: flex-start;
    transition: all 0.4s cubic-bezier(0.4,0,0.2,1);
    position: relative; overflow: hidden;
  }
  .video-feature::after {
    content: '';
    position: absolute; bottom: 0; left: 10%; right: 10%;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(249,115,22,0.5), transparent);
    opacity: 0; transition: opacity 0.4s;
  }
  .video-feature:hover::after { opacity: 1; }
  .video-feature:hover {
    background: rgba(249,115,22,0.04);
    transform: translateY(-5px);
    border-color: rgba(249,115,22,0.12);
    box-shadow: 0 30px 60px rgba(0,0,0,0.3);
  }
  .video-icon {
    width: 50px; height: 50px; border-radius: 14px; flex-shrink: 0;
    background: linear-gradient(135deg, rgba(249,115,22,0.2), rgba(251,191,36,0.1));
    border: 1px solid rgba(249,115,22,0.2);
    display: flex; align-items: center; justify-content: center; color: var(--o);
  }
  .video-icon svg { width: 24px; height: 24px; }
  .video-feature-text h3 {
    font-size: 1rem; font-weight: 700;
    margin-bottom: 0.625rem; letter-spacing: -0.01em;
  }
  .video-feature-text p { color: var(--muted); font-size: 0.9rem; line-height: 1.75; }

  /* ======= PARTNER ======= */
  .partner-card {
    max-width: 860px; margin: 0 auto;
    background: rgba(255,255,255,0.025);
    border: 1px solid rgba(255,255,255,0.07);
    border-radius: 24px; padding: 3rem;
  }
  .partner-head {
    display: flex; align-items: center; gap: 1.25rem; margin-bottom: 1.5rem;
  }
  .partner-avatar {
    width: 64px; height: 64px; border-radius: 16px; flex-shrink: 0;
    background: var(--grad);
    display: flex; align-items: center; justify-content: center;
    font-size: 1.3rem; font-weight: 900; color: white; letter-spacing: -1px;
  }
  .partner-card h3 { font-size: 1.4rem; font-weight: 800; margin-bottom: 0.25rem; }
  .partner-card > p { color: var(--muted); line-height: 1.8; margin-bottom: 1rem; }
  .partner-highlight {
    background: rgba(124,58,237,0.08); border: 1px solid rgba(124,58,237,0.2);
    border-radius: 12px; padding: 1.25rem; color: var(--text); line-height: 1.7;
    margin-bottom: 1.5rem; font-size: 0.95rem;
  }
  .partner-sites-label { font-size: 0.85rem; font-weight: 600; color: var(--muted); margin-bottom: 1rem; text-transform: uppercase; letter-spacing: 1px; }
  .partner-sites-grid {
    display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem;
  }
  .partner-site-card {
    border-radius: 12px; overflow: hidden; aspect-ratio: 16/10;
    border: 1px solid var(--border); transition: all 0.3s;
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    gap: 0.5rem; color: var(--muted); font-size: 0.85rem; font-weight: 500;
    text-decoration: none;
  }
  .coming-soon { background: rgba(255,255,255,0.02); }
  .site-placeholder { color: rgba(255,255,255,0.2); }
  .site-placeholder svg { width: 32px; height: 32px; }

  /* ======= CONTACT ======= */
  .contact-layout {
    display: grid; grid-template-columns: 1fr 1.4fr;
    gap: 4rem; align-items: start;
    max-width: 1000px; margin: 0 auto;
  }
  .contact-cta-side { display: flex; flex-direction: column; gap: 1.5rem; }
  .btn-wa-big {
    display: flex; align-items: center; justify-content: center; gap: 0.75rem;
    background: #25D366; color: white; padding: 1.25rem 2rem;
    border-radius: 12px; font-weight: 700; font-size: 1.1rem;
    text-decoration: none; transition: all 0.3s;
    box-shadow: 0 6px 20px rgba(37,211,102,0.3);
  }
  .btn-wa-big svg { width: 24px; height: 24px; fill: white; }
  .btn-wa-big:hover { background: #128C7E; transform: translateY(-2px); box-shadow: 0 10px 30px rgba(37,211,102,0.4); }
  .contact-info { display: flex; flex-direction: column; gap: 0.5rem; }
  .contact-info p { color: var(--muted); font-size: 1rem; }
  .contact-info a { color: #a78bfa; text-decoration: none; font-weight: 600; transition: color 0.2s; }
  .contact-info a:hover { color: var(--text); }
  .form-label { color: var(--muted); font-size: 0.9rem; margin-bottom: 1rem; }
  .contact-form { display: flex; flex-direction: column; gap: 1rem; }
  .contact-form input, .contact-form textarea {
    background: rgba(255,255,255,0.04); border: 1px solid var(--border);
    border-radius: 10px; padding: 0.875rem 1rem; color: var(--text);
    font-size: 0.95rem; font-family: inherit; transition: all 0.2s;
    width: 100%;
  }
  .contact-form input::placeholder, .contact-form textarea::placeholder { color: var(--muted); }
  .contact-form input:focus, .contact-form textarea:focus {
    outline: none; border-color: var(--v);
    box-shadow: 0 0 0 3px rgba(124,58,237,0.15);
    background: rgba(255,255,255,0.06);
  }
  .contact-form textarea { resize: vertical; min-height: 120px; }
  .privacy-check { display: flex; gap: 0.75rem; align-items: flex-start; cursor: pointer; }
  .privacy-check input { margin-top: 0.2rem; accent-color: var(--v); flex-shrink: 0; width: 16px; height: 16px; }
  .privacy-check span { font-size: 0.85rem; color: var(--muted); line-height: 1.5; }

  /* ======= LEGAL PAGES ======= */
  .legal-page { display: none; background: var(--bg); min-height: 100vh; padding-top: var(--nav-h); }
  .legal-page.visible { display: block; }
  .legal-wrap { max-width: 780px; margin: 0 auto; padding: 3rem 2rem; }
  .legal-back {
    display: inline-flex; align-items: center; gap: 0.5rem;
    background: none; border: none; color: var(--v); font-weight: 600; font-size: 0.95rem;
    cursor: pointer; margin-bottom: 2rem; padding: 0; transition: color 0.2s;
  }
  .legal-back:hover { color: #a78bfa; }
  .legal-wrap h1 { font-size: 2rem; font-weight: 800; margin-bottom: 0.5rem; }
  .legal-date { color: var(--muted); font-size: 0.9rem; margin-bottom: 2rem; }
  .legal-wrap h2 { font-size: 1.2rem; font-weight: 700; margin: 2rem 0 0.75rem; color: var(--text); }
  .legal-wrap p, .legal-wrap li { color: var(--muted); line-height: 1.8; margin-bottom: 0.5rem; font-size: 0.95rem; }
  .legal-wrap ul { padding-left: 1.5rem; }
  .legal-wrap strong { color: var(--text); }

  /* ======= FOOTER ======= */
  footer {
    background: #040410; border-top: 1px solid var(--border);
    padding: 4rem 2rem 2rem;
  }
  .footer-top {
    display: grid; grid-template-columns: 2fr 1fr 1fr 1fr;
    gap: 3rem; margin-bottom: 3rem;
  }
  .footer-brand .logo { margin-bottom: 1rem; }
  .footer-brand > p { color: var(--muted); font-size: 0.9rem; line-height: 1.6; margin-bottom: 0.5rem; }
  .footer-legal { font-size: 0.8rem !important; color: rgba(100,116,139,0.7) !important; }
  .footer-links-col { display: flex; flex-direction: column; gap: 0.5rem; }
  .footer-links-col h4 { color: var(--text); font-weight: 700; font-size: 0.9rem; margin-bottom: 0.5rem; }
  .footer-links-col a {
    color: var(--muted); text-decoration: none; font-size: 0.875rem;
    transition: color 0.2s;
  }
  .footer-links-col a:hover { color: var(--text); }
  .footer-bottom {
    border-top: 1px solid var(--border); padding-top: 2rem;
    display: flex; justify-content: space-between; align-items: center;
    flex-wrap: wrap; gap: 1rem;
  }
  .footer-bottom > p { color: var(--muted); font-size: 0.85rem; }
  .footer-legal-links { display: flex; align-items: center; gap: 1.5rem; flex-wrap: wrap; }
  .back-top {
    background: var(--grad); color: white;
    padding: 0.4rem 1rem; border-radius: 6px; border: none;
    cursor: pointer; font-size: 0.85rem; font-weight: 600; transition: all 0.2s;
  }
  .back-top:hover { transform: translateY(-2px); }

  /* ======= COOKIE BANNER ======= */
  .cookie-banner {
    position: fixed; bottom: 0; left: 0; right: 0;
    background: rgba(4,4,16,0.97); border-top: 1px solid var(--border);
    backdrop-filter: blur(20px); z-index: 2000; padding: 1.25rem 2rem;
    display: none;
  }
  .cookie-banner.show { display: block; }
  .cookie-inner {
    max-width: 1200px; margin: 0 auto;
    display: flex; align-items: center; gap: 2rem; flex-wrap: wrap;
  }
  .cookie-text { flex: 1; }
  .cookie-text strong { color: var(--text); font-size: 0.95rem; }
  .cookie-text p { color: var(--muted); font-size: 0.85rem; margin-top: 0.25rem; }
  .cookie-actions { display: flex; gap: 0.75rem; flex-wrap: wrap; align-items: center; }
  .cookie-btn {
    padding: 0.6rem 1.25rem; border-radius: 8px;
    font-weight: 600; font-size: 0.85rem; cursor: pointer; transition: all 0.2s; border: none;
  }
  .cookie-accept { background: var(--grad); color: white; }
  .cookie-accept:hover { opacity: 0.9; }
  .cookie-reject { background: rgba(255,255,255,0.08); color: var(--muted); border: 1px solid var(--border); }
  .cookie-reject:hover { background: rgba(255,255,255,0.12); color: var(--text); }
  .cookie-settings-btn { background: none; color: var(--muted); text-decoration: underline; }
  .cookie-settings-btn:hover { color: var(--text); }

  /* ======= COOKIE MODAL ======= */
  .cookie-modal {
    position: fixed; inset: 0; background: rgba(0,0,0,0.7);
    z-index: 2001; display: none; align-items: center; justify-content: center; padding: 1rem;
  }
  .cookie-modal.open { display: flex; }
  .cookie-modal-box {
    background: #0e0e28; border: 1px solid var(--border);
    border-radius: 16px; max-width: 560px; width: 100%;
    max-height: 80vh; overflow-y: auto; padding: 2rem;
  }
  .cookie-modal-head {
    display: flex; justify-content: space-between; align-items: center;
    margin-bottom: 1.5rem;
  }
  .cookie-modal-head h3 { font-size: 1.2rem; font-weight: 700; }
  .cookie-modal-head button { background: none; border: none; color: var(--muted); font-size: 1.4rem; cursor: pointer; transition: color 0.2s; }
  .cookie-modal-head button:hover { color: var(--text); }
  .cookie-cat { padding: 1rem 0; border-bottom: 1px solid var(--border); }
  .cookie-cat:last-of-type { border-bottom: none; }
  .cookie-cat-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem; }
  .cookie-cat h4 { font-size: 0.95rem; font-weight: 600; }
  .cookie-cat p { color: var(--muted); font-size: 0.85rem; line-height: 1.5; }
  .cookie-modal-foot { margin-top: 1.5rem; }
  .toggle { position: relative; width: 48px; height: 26px; display: block; }
  .toggle input { opacity: 0; width: 0; height: 0; }
  .slider {
    position: absolute; inset: 0; cursor: pointer;
    background: rgba(255,255,255,0.15); border-radius: 999px; transition: 0.3s;
  }
  .slider:before {
    content: ''; position: absolute;
    width: 20px; height: 20px; left: 3px; bottom: 3px;
    background: white; border-radius: 50%; transition: 0.3s;
  }
  .toggle input:checked + .slider { background: var(--v); }
  .toggle input:checked + .slider:before { transform: translateX(22px); }
  .toggle input:disabled + .slider { background: rgba(124,58,237,0.5); cursor: not-allowed; }

  /* ======= WHATSAPP FLOAT ======= */
  .whatsapp-float {
    position: fixed; bottom: 2rem; right: 2rem;
    width: 58px; height: 58px; background: #25D366;
    border-radius: 50%; display: flex; align-items: center; justify-content: center;
    box-shadow: 0 4px 20px rgba(37,211,102,0.45);
    z-index: 999; transition: all 0.3s;
  }
  .whatsapp-float:hover { transform: scale(1.1); box-shadow: 0 6px 30px rgba(37,211,102,0.6); }
  .whatsapp-float svg { width: 32px; height: 32px; fill: white; }

  /* ======= LINK BUTTON ======= */
  .link-btn {
    background: none; border: none; color: #a78bfa;
    cursor: pointer; font-size: inherit; text-decoration: underline;
    padding: 0; transition: color 0.2s;
  }
  .link-btn:hover { color: var(--text); }

  /* ======= RESPONSIVE ======= */
  @media (max-width: 1100px) {
    .cards-grid { grid-template-columns: repeat(2, 1fr); }
    .steps-grid { grid-template-columns: repeat(2, 1fr); }
    .portfolio-grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 1024px) {
    .footer-top { grid-template-columns: 1fr 1fr; }
    .footer-brand { grid-column: 1 / -1; }
    .about-grid { grid-template-columns: 1fr; gap: 3rem; }
    .about-img-wrap { position: static; max-width: 340px; margin: 0 auto; }
  }

  @media (max-width: 768px) {
    :root { --nav-h: 64px; }
    .nav-links { display: none; }
    .hamburger { display: flex; }
    .hero h1 { font-size: 2rem; }
    .hero-stats { gap: 1rem; }
    .stat-div { display: none; }
    .hero-btns { flex-direction: column; align-items: center; }
    .hero-btns .btn { width: 100%; max-width: 360px; justify-content: center; }
    .section-dark, .section-alt { padding: 4.5rem 1.5rem; }
    .cards-grid { grid-template-columns: 1fr; }
    .steps-grid { grid-template-columns: 1fr; }
    .portfolio-grid { grid-template-columns: 1fr; }
    .video-grid { grid-template-columns: 1fr; }
    .video-grid { grid-template-columns: 1fr; }
    .contact-layout { grid-template-columns: 1fr; gap: 2rem; }
    .partner-sites-grid { grid-template-columns: 1fr; }
    .footer-top { grid-template-columns: 1fr; gap: 2rem; }
    .footer-brand { grid-column: auto; }
    .footer-bottom { flex-direction: column; text-align: center; }
    .footer-legal-links { justify-content: center; }
    .cookie-inner { flex-direction: column; gap: 1rem; }
    .cookie-actions { justify-content: center; }
    .whatsapp-float { bottom: 1.25rem; right: 1.25rem; width: 52px; height: 52px; }
    .whatsapp-float svg { width: 28px; height: 28px; }
    .clients-logos { gap: 2rem; }
    .hero-orb-1 { width: 300px; height: 300px; }
    .hero-orb-2 { width: 250px; height: 250px; }
  }

  @media (max-width: 480px) {
    .container { padding: 0 1.25rem; }
    .nav-container { padding: 0 1.25rem; }
    .hero h1 { font-size: 1.75rem; }
    .partner-sites-grid { grid-template-columns: 1fr 1fr; }
  }
</style>

<!-- ========== SCRIPTS ========== -->
<script is:inline>
  // ===== COOKIE MANAGEMENT =====
  function getCookieConsent() {
    const c = localStorage.getItem('cookieConsent');
    return c ? JSON.parse(c) : null;
  }
  function setCookieConsent(c) {
    localStorage.setItem('cookieConsent', JSON.stringify(c));
  }
  function acceptAllCookies() {
    setCookieConsent({ necessary: true, analytics: true, marketing: true, ts: Date.now() });
    document.getElementById('cookieBanner').classList.remove('show');
    loadAnalytics(); loadMarketing();
  }
  function rejectOptionalCookies() {
    setCookieConsent({ necessary: true, analytics: false, marketing: false, ts: Date.now() });
    document.getElementById('cookieBanner').classList.remove('show');
  }
  function openCookieSettings() {
    const c = getCookieConsent();
    if (c) {
      document.getElementById('analyticsCookies').checked = c.analytics;
      document.getElementById('marketingCookies').checked = c.marketing;
    }
    document.getElementById('cookieModal').classList.add('open');
    document.getElementById('cookieBanner').classList.remove('show');
  }
  function closeCookieSettings() {
    document.getElementById('cookieModal').classList.remove('open');
    if (!getCookieConsent()) document.getElementById('cookieBanner').classList.add('show');
  }
  function saveCookieSettings() {
    const analytics = document.getElementById('analyticsCookies').checked;
    const marketing = document.getElementById('marketingCookies').checked;
    setCookieConsent({ necessary: true, analytics, marketing, ts: Date.now() });
    document.getElementById('cookieModal').classList.remove('open');
    if (analytics) loadAnalytics();
    if (marketing) loadMarketing();
  }
  function loadAnalytics() { /* Google Analytics placeholder */ }
  function loadMarketing() { /* Meta Pixel placeholder */ }

  window.addEventListener('load', () => {
    const c = getCookieConsent();
    if (!c) {
      document.getElementById('cookieBanner').classList.add('show');
    } else {
      if (c.analytics) loadAnalytics();
      if (c.marketing) loadMarketing();
    }
  });

  // ===== PAGE NAVIGATION =====
  function showPage(page) {
    const main = document.getElementById('mainContent');
    const privacy = document.getElementById('privacyPage');
    const cookie = document.getElementById('cookiePage');
    main.style.display = 'block';
    privacy.classList.remove('visible');
    cookie.classList.remove('visible');
    if (page === 'privacy') {
      main.style.display = 'none';
      privacy.classList.add('visible');
      window.scrollTo({ top: 0, behavior: 'smooth' });
    } else if (page === 'cookie') {
      main.style.display = 'none';
      cookie.classList.add('visible');
      window.scrollTo({ top: 0, behavior: 'smooth' });
    } else {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }
  }

  // ===== MOBILE MENU =====
  function toggleMobileMenu() {
    const hb = document.getElementById('hamburger');
    const mm = document.getElementById('mobileMenu');
    hb.classList.toggle('open');
    mm.classList.toggle('open');
    document.body.style.overflow = mm.classList.contains('open') ? 'hidden' : '';
  }
  function closeMobileMenu() {
    document.getElementById('hamburger').classList.remove('open');
    document.getElementById('mobileMenu').classList.remove('open');
    document.body.style.overflow = '';
  }

  // ===== PORTFOLIO EXPAND =====
  function expandPortfolio(id) {
    document.getElementById(id + '-preview').style.display = 'none';
    document.getElementById(id + '-full').classList.add('open');
  }
  function collapsePortfolio(id) {
    document.getElementById(id + '-preview').style.display = 'block';
    document.getElementById(id + '-full').classList.remove('open');
  }

  // ===== CONTACT FORM =====
  function handleEmailSubmit(e) {
    e.preventDefault();
    const f = e.target;
    const nome = f.elements['nome'].value.trim();
    const email = f.elements['email'].value.trim();
    const business = f.elements['business'].value.trim();
    const messaggio = f.elements['messaggio'].value.trim();
    const subject = encodeURIComponent('Richiesta consulenza gratuita 30 minuti - GZ Marketing Agency');
    const body = encodeURIComponent('Nome: ' + nome + '\nEmail: ' + email + '\nAzienda: ' + business + '\n\nMessaggio:\n' + messaggio);
    window.location.href = 'mailto:gabriele.zerbonia@gmail.com?subject=' + subject + '&body=' + body;
    f.reset();
  }

  // ===== HEADER SCROLL =====
  window.addEventListener('scroll', () => {
    const h = document.querySelector('header');
    if (window.scrollY > 50) {
      h.style.background = 'rgba(7,7,26,0.97)';
    } else {
      h.style.background = 'rgba(7,7,26,0.92)';
    }
  });

  // ===== YEAR =====
  document.getElementById('year').textContent = String(new Date().getFullYear());
</script>

</Layout>
