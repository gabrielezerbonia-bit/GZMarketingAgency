---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import MobileMenu from '../components/MobileMenu.astro';
import CookieBanner from '../components/CookieBanner.astro';
import Hero from '../components/Hero.astro';
import ClientsBar from '../components/ClientsBar.astro';
import Services from '../components/Services.astro';
import About from '../components/About.astro';
import Process from '../components/Process.astro';
import Portfolio from '../components/Portfolio.astro';
import VideoSection from '../components/VideoSection.astro';
import Partnership from '../components/Partnership.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
import LegalPages from '../components/LegalPages.astro';
---

<Layout
  title="GZ Marketing Agency | Crescita del Profitto & Brand Identity"
  description="GZ Marketing Agency: aumentiamo il profitto di aziende e professionisti attraverso strategie di marketing avanzate, branding, content creation e produzione video. Consulenza gratuita."
>

<a href="https://wa.me/393513456448?text=Ciao%20Gabriele%2C%20vorrei%20prenotare%20una%20consulenza%20gratuita"
   target="_blank" rel="noopener" class="whatsapp-float" aria-label="Contattaci su WhatsApp">
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
</a>

<CookieBanner />
<MobileMenu />
<Header />

<div id="mainContent">
  <Hero />
  <ClientsBar />
  <Services />
  <About />
  <Process />
  <Portfolio />
  <VideoSection />
  <Partnership />
  <Contact />
</div>

<LegalPages />
<Footer />

<script is:inline>
  // ===== COOKIE =====
  function getCookieConsent() { const c = localStorage.getItem('cookieConsent'); return c ? JSON.parse(c) : null; }
  function setCookieConsent(c) { localStorage.setItem('cookieConsent', JSON.stringify(c)); }
  function acceptAllCookies() {
    setCookieConsent({ necessary: true, analytics: true, marketing: true, ts: Date.now() });
    document.getElementById('cookieBanner').classList.remove('show');
    loadAnalytics(); loadMarketing();
  }
  function rejectOptionalCookies() {
    setCookieConsent({ necessary: true, analytics: false, marketing: false, ts: Date.now() });
    document.getElementById('cookieBanner').classList.remove('show');
  }
  function openCookieSettings() {
    const c = getCookieConsent();
    if (c) { document.getElementById('analyticsCookies').checked = c.analytics; document.getElementById('marketingCookies').checked = c.marketing; }
    document.getElementById('cookieModal').classList.add('open');
    document.getElementById('cookieBanner').classList.remove('show');
  }
  function closeCookieSettings() {
    document.getElementById('cookieModal').classList.remove('open');
    if (!getCookieConsent()) document.getElementById('cookieBanner').classList.add('show');
  }
  function saveCookieSettings() {
    const analytics = document.getElementById('analyticsCookies').checked;
    const marketing = document.getElementById('marketingCookies').checked;
    setCookieConsent({ necessary: true, analytics, marketing, ts: Date.now() });
    document.getElementById('cookieModal').classList.remove('open');
    if (analytics) loadAnalytics();
    if (marketing) loadMarketing();
  }
  function loadAnalytics() {}
  function loadMarketing() {}

  // ===== PAGE NAVIGATION =====
  function showPage(page) {
    const main = document.getElementById('mainContent');
    const privacy = document.getElementById('privacyPage');
    const cookie = document.getElementById('cookiePage');
    main.style.display = 'block';
    privacy.classList.remove('visible');
    cookie.classList.remove('visible');
    if (page === 'privacy') {
      main.style.display = 'none';
      privacy.classList.add('visible');
      window.scrollTo({ top: 0, behavior: 'smooth' });
    } else if (page === 'cookie') {
      main.style.display = 'none';
      cookie.classList.add('visible');
      window.scrollTo({ top: 0, behavior: 'smooth' });
    } else {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }
  }

  // ===== MOBILE MENU =====
  function toggleMobileMenu() {
    const hb = document.getElementById('hamburger');
    const mm = document.getElementById('mobileMenu');
    hb.classList.toggle('open');
    mm.classList.toggle('open');
    document.body.style.overflow = mm.classList.contains('open') ? 'hidden' : '';
  }
  function closeMobileMenu() {
    document.getElementById('hamburger').classList.remove('open');
    document.getElementById('mobileMenu').classList.remove('open');
    document.body.style.overflow = '';
  }

  // ===== PORTFOLIO EXPAND =====
  function expandPortfolio(id) {
    document.getElementById(id + '-preview').style.display = 'none';
    document.getElementById(id + '-full').classList.add('open');
  }
  function collapsePortfolio(id) {
    document.getElementById(id + '-preview').style.display = 'block';
    document.getElementById(id + '-full').classList.remove('open');
  }

  // ===== PROCESS TABS =====
  function setStep(n) {
    document.querySelectorAll('.pnav-item').forEach(function(el, i) { el.classList.toggle('active', i === n); });
    document.querySelectorAll('.process-panel').forEach(function(el, i) { el.classList.toggle('active', i === n); });
  }

  // ===== CONTACT FORM =====
  function handleEmailSubmit(e) {
    e.preventDefault();
    var f = e.target;
    var nome = f.elements['nome'].value.trim();
    var email = f.elements['email'].value.trim();
    var business = f.elements['business'].value.trim();
    var messaggio = f.elements['messaggio'].value.trim();
    var subject = encodeURIComponent('Richiesta consulenza gratuita — GZ Marketing Agency');
    var body = encodeURIComponent('Nome: ' + nome + '\nEmail: ' + email + '\nAzienda: ' + business + '\n\nMessaggio:\n' + messaggio);
    window.location.href = 'mailto:gabriele.zerbonia@gmail.com?subject=' + subject + '&body=' + body;
    f.reset();
  }

  // ===== SCROLL: progress + header =====
  window.addEventListener('scroll', function() {
    var total = document.body.scrollHeight - window.innerHeight;
    var pct = total > 0 ? (window.scrollY / total) * 100 : 0;
    var pb = document.getElementById('scrollProgress');
    if (pb) pb.style.width = pct + '%';
    var h = document.querySelector('header');
    if (h) h.style.background = window.scrollY > 50 ? 'rgba(7,7,26,0.97)' : 'rgba(7,7,26,0.92)';
  });

  // ===== SECTION DOTS =====
  var secIds = ['home','servizi','chi-siamo','processo','portfolio','video','partner','contatti'];
  var secDots = document.querySelectorAll('.sec-dot');
  secDots.forEach(function(btn) {
    btn.addEventListener('click', function() {
      var t = btn.dataset.target;
      if (t === 'home') { window.scrollTo({ top: 0, behavior: 'smooth' }); }
      else { var el = document.getElementById(t); if (el) el.scrollIntoView({ behavior: 'smooth' }); }
    });
  });
  var secEls = secIds.map(function(id) { return document.getElementById(id); }).filter(Boolean);
  if (typeof IntersectionObserver !== 'undefined') {
    var secObs = new IntersectionObserver(function(entries) {
      entries.forEach(function(entry) {
        if (entry.isIntersecting) {
          var idx = secIds.indexOf(entry.target.id);
          secDots.forEach(function(d, i) { d.classList.toggle('active', i === idx); });
        }
      });
    }, { rootMargin: '-40% 0px -40% 0px' });
    secEls.forEach(function(el) { secObs.observe(el); });
  }

  // ===== SCROLL ANIMATIONS =====
  if (typeof IntersectionObserver !== 'undefined') {
    var animObs = new IntersectionObserver(function(entries) {
      entries.forEach(function(entry) {
        if (entry.isIntersecting) {
          entry.target.classList.add('in-view');
          animObs.unobserve(entry.target);
        }
      });
    }, { threshold: 0.1 });
    document.querySelectorAll('[data-anim]').forEach(function(el) { animObs.observe(el); });
  }

  // ===== COUNTER ANIMATION =====
  function animateCount(id, from, to, duration, prefix, suffix) {
    var el = document.getElementById(id);
    if (!el) return;
    var start = null;
    function step(ts) {
      if (!start) start = ts;
      var progress = Math.min((ts - start) / duration, 1);
      var eased = 1 - Math.pow(1 - progress, 3);
      el.textContent = prefix + Math.round(from + eased * (to - from)) + suffix;
      if (progress < 1) requestAnimationFrame(step);
    }
    requestAnimationFrame(step);
  }
  setTimeout(function() {
    animateCount('cnt1', 0, 6, 1600, '', '+');
    animateCount('cnt2', 0, 23, 2000, '', 'K+');
    animateCount('cnt3', 0, 4, 1400, '', 'x');
    animateCount('cnt4', 0, 100, 2200, '', '%');
  }, 600);

  // ===== YEAR =====
  document.getElementById('year').textContent = String(new Date().getFullYear());
</script>

</Layout>
